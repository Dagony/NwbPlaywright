<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
    <NUnit>
        <NumberOfTestWorkers>6</NumberOfTestWorkers>
    </NUnit>
    <RunConfiguration>
        <TestCaseFilter>TestCategory != BekijkenVoorVerwijdering &amp; TestCategory = Smoke</TestCaseFilter>
        <EnvironmentVariables>
            <DEBUG>pw:api</DEBUG>
        </EnvironmentVariables>
    </RunConfiguration>
    <Playwright>
        <LaunchOptions>
            <Headless>false</Headless>
            <Channel>chromium</Channel>
        </LaunchOptions>
    </Playwright>
    <DataCollectionRunSettings>
        <DataCollectors>
            <DataCollector friendlyName="blame" enabled="True">
                <Configuration>
                    <CollectDump DumpType="Full" />
                    <CollectDumpOnTestSessionHang TestTimeout="10min" HangDumpType="Full" />
                </Configuration>
            </DataCollector>
        </DataCollectors>
    </DataCollectionRunSettings>
</RunSettings>